@import "common-rules.styl"
/*------------------------------------------------------------------------------------------------------------------------------------------*/
#votingSlideDiv
    .mainWrapper
        .tnc
            &-container
                background-color transparent
                max-width 28rem
                margin 10rem auto 0 auto
                padding 1rem 2rem
                border-radius $radius
                overflow hidden
                box-shadow none
            &-instructions
                text-align center
                margin 0
                &__text
                    background-color transparent
                    padding 0
                    color $white
                    font-size 1.7rem
                    font-weight normal
                    &:before
                        content ''
                        display block
                        width 4.5rem
                        height 4.5rem
                        margin 1rem auto
                        background-image url('../images/team.png')
                        background-repeat no-repeat
                        background-position center
                        background-size contain
            &-buttons.cl-buttons
                text-align center
                float none
                .cl-button--clear
                    display none !important
                .cl-button--submit
                    float none !important
            &-textarea-container
                margin 1rem auto
                text-align center
                input
                    box-shadow none
                    width 100%
                    padding 1.06rem
                    border-radius 2rem
                    text-align center
                    background-color transparent
                    color $white
                .inputComponentMessageLength
                    text-align center
                    font-size 1rem
                    padding 5px 0 0 0
                    position static
                    width 100%
                    color white
            &-thankyou
                display none
                // background-color #051a33
                border-radius 1.4rem
                text-align center
                padding 5.5rem 3.5rem 5rem
                &__title
                    color #ffb93b
                    font-family 'Gibson-SemiBold'
                    font-size 4rem
                    line-height 1.15
                    margin 0 0 2rem
                &__message
                    color $white
                    font-family 'Gibson-Regular'
                    font-size 2.15rem
                    line-height 1.55
                    margin 0 auto
                    max-width 48rem
            &.is-submitted
                .tnc-form
                    display none
                .tnc-thankyou
                    display block
                .tnc-container
                    max-width 56rem
                    margin 6rem auto 0
                    padding 0
                    overflow visible
                    background-color transparent
/*------------------------------------------------------------------------------------------------------------------------------------------*/
@media screen and (max-width 600px)
    #votingSlideDiv
        .mainWrapper
            .tnc-container
                margin 8rem auto 0
            .tnc.is-submitted
                .tnc-container
                    margin 4rem auto 0
            .tnc-thankyou
                padding 3.5rem 1.75rem 3.25rem
                &__title
                    font-size 2.8rem
                &__message
                    font-size 1.6rem