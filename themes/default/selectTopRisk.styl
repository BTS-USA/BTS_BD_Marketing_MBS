// import variables and mixins
@import "shared/cl.styl"

        
.topRisk
    &__dropdownCont
        border 2px solid gray
        border-radius 5px
        margin-left 10px
        color gray
        width 200px
        padding 5px
        cursor pointer
    &__sortContainerWrapper    
        flex 0 0 40%
        display flex
        justify-content flex-end
        @media screen and (max-width 768px)
            justify-content center
    &__sortCont
        margin-right 2%
        display none
        i
            color white
            line-height 0
            &:before
                font-size 1.2rem
    &__mainContWrapper
        width 100% 
    &__votesWrapper
        background white
        margin 15px 10px
        width 31%
        display inline-block
        height 230px
        @media screen and (max-width 767px)
            width 90%
            margin 18px
        @media screen and (min-width 768px) and (max-width 1023px)
            width 45%
            margin 17px
    &__extraWrapper
        height 100%
    &__left
        padding 10px 5% 0px 11px
        color #ffffff
    &__warning
        font-size small
    &__title
        &Cont
            display flex
            padding 10px
            border-bottom 1px solid lightgray
            color gray
            height calc(100% - 187px)
        &PeopleIcon
            flex 0 0 10%
        &Authortext
            flex 0 0 80%
            font-size 14px
    &__like
        flex 0 0 10%
        &--checked          
            color red
        &--disabled
            opacity 0.4
            pointer-events none
        &:before
            cursor pointer    
    &__idea
        &Cont
            height calc(100% - 78px)
            padding 20px 30px
            color dimgray
        &Text
            height calc(100% - 25px)
            overflow-y auto
        &RiskThemeText
            margin 10px 0 0 0
            font-size 13px
        &RiskThemeType
            font-weight 600
    &__attributes
        background #e0dfdf
        font-size 14px
        color #969ba7
        padding 10px 2px
        border-top 1px solid lightgray
        display flex
        justify-content space-evenly
    &__attr
        font-size 11px
        padding 0 5px 0 2px
        vertical-align top
::-webkit-scrollbar-track
    -webkit-box-shadow inset 0 0 6px rgba(0,0,0,0.3)
    background-color #F5F5F5


::-webkit-scrollbar
    width 5px
    border-radius 50%
    background-color #F5F5F5

::-webkit-scrollbar-thumb
    background-color #b2b2b2

.dark-area {
    background-color: #666;
    padding: 40px;
    margin: 0 -40px 20px -40px;
    clear: both;
}

.clearfix:before,.clearfix:after {content: " "; display: table;}
.clearfix:after {clear: both;}
.clearfix {*zoom: 1;}
.c100.small
    font-size 18px
    &:hover
        font-size 18px
.c100:after, .c100:hover:after
    top 0.156em
    left 0.150em
    width 0.69em
    height 0.69em
    background-color #e0dfdf
.c100 .bar
    border 0.15em solid $emerald
    width 0.69em
    height 0.70em

