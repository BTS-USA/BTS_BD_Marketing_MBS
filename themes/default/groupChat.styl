.chat 
    background-color #fff
    margin 0 auto
    overflow-y scroll
    width 100%
    height 200px

.chat li
    margin-bottom 5px

.chat li.left .chat-body
    margin-left 0px

.chat li.right .chat-body
    margin-right 5px

.chat li .chat-body p
    margin 0
    color #343a40

.chat-msgText
    font-size 13px
    font-weight 600
.primary-font
    color #343a40
    font-family Arial

.chat-text
    font-size 12px    
.chat-time_date
    color #a08c8c
    display block
    font-size 11px
    margin 0px 0px 5px 0px
    float right
.header 
    font-family Segoe UI

ul 
  list-style-type none
  padding 0 0 0 10px

.pull-right 
    float right

.time_date 
    color #747474
    display block
    font-size 11px
    margin 0px 10px 5px 0px
    float right
.notification
    &-common
        border-radius 10px
        font-size 14px
        margin-top 5px
        padding 5px 10px 10px 10px
        margin-right 10px
        border-top-left-radius 0
        width 85%
        float left
    &-leadermsgs
        background rgba(0, 185, 240, 1)
        color #fff
    &-othermsgs
        border 1px solid lightgray
        color black
    &-newmsg
        border-bottom-right-radius 0
        padding 5px 10px 10px 10px
        color black
        width 85%
        float right
    &-counter-latest-chat
        background:#80cc28 !important;

  .leaderChat      
      background: deepskyblue !important;
  .CurrUser
      background: #80cc28 !important;    
  .OtherUsers
      background: #fff !important;
      color: #434951 !important;