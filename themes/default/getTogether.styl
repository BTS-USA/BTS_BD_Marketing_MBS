// Import variables and mixins
@import "shared/cl.styl"

.gtr
    &__footer
        float left
        width 100%
        background-color transparent
        padding 20px
        position relative
        display flex
        justify-content center
    &__article
        box-shadow rgba(0, 0, 0, 0.1) 0px 24px 36px
        padding 65px 10px 20px
        margin-top -50px
        margin-bottom 20px
        background-color rgba(0, 0, 0, 0.1)
        border-radius 12px
    &__title-main
        text-align center
        text-transform uppercase
        font-size 24px
        margin-top 16px
        color $mediumgrey
        vendor(transition, all .5s ease)
        font-weight 300
        position relative
        z-index 10
        font-family OpenSans
    &__note
        padding 5px 40px 10px 40px !important
    &__profile
        padding 0 0.5rem
        height auto
        &.name
                width 100%
                input
                    height 40px
                    border 3px solid rgba(128,128,128,0.2)
                    font-size 14px
                    color $grey
                    width 100%
                    vendor(transition, all .5s ease)
                    &:active, &:focus
                        border 3px solid $color-primary
                        box-shadow none
                        box-shadow 2px 2px 5px 0px rgba(0, 0, 0, 0.15) inset
                    &::placeholder
                        color rgba(0,0,0,0.3)
            label
                font-size 14px
                color $grey
                padding-left 8px
                line-height 1em
    &__btn-container 
        margin 10px 0 0 0
    &__disabled
        font-size 1.6*$px
        color $codGray
        padding 5px 0
        display inline-block
    &__instructions
        margin 40px 0 0 0
        &-title
            font-size 3.2*$px
            color $cerulean
            font-weight 100
        &-text
            font-size 1.8*$px
    &_form_body
        margin 0 0 20px 0
        background-color transparent
        max-width 600px
        float none
        margin auto
    &_RegistrationButton, &_CancelButton, &_ClearButton
        float none
        margin 0 auto
        width 11.1*$px
    &__policy
        float left
        width 100%
        margin 20px 0 0 0
        &-text
            font-size 1.2*$px
            color $gray
            padding 0 40px
            text-align center
    &__ErrorMsg 
        display none
        padding 5px
        background-color #FF4E3A
        color #FFFFFF
        text-align center
        position absolute
        top -29px
        width 100%
        left 0
    &_Buttons
        vertical-align middle
        height 40px
        margin 10px 5px 0 0
        padding 0 20px 0 20px
        background #36b544
        cursor pointer
        width 100px
        text-align center
        line-height 40px
        color #fff
        float left
    &.cl__component
        float none
        margin 0 auto
    &.cl__component::after
        clear both
        content ""


    /* unique form elements
    **********************************/
    /* if this works out we can move these to CL */
    label
        color $gray
        font-size 14px
        padding-left 8px
        line-height 1em

    input[type="text"], input[type="password"] 
        border 1px solid $mercury
        color $codGray
        padding 7px 5px
        font-size 1.6*$px
        line-height 1.4em
        font-weight 400
        width 100%
        &::-webkit-input-placeholder
            font-style italic
    .checkbox
        display:block
        padding 1*$px 
        z-index 9

    .optionText 
        padding 0 9px

    .multi-check 
        background-color #4d4d4d
        color white
        position relative
        border-radius 5px

    .dropdown
        width: 100%
        border: 1px solid #ccc
        background-color #FFFFFF
        z-index 999999999
        display none
        position absolute
        box-sizing border-box
    .rootNode 
        display inline-block
        padding 1*$px
        width 100%
        cursor pointer
        box-sizing border-box
    .dropPlaceholder 
        padding 10px
    .arrow-down 
        width 14px
        height 14px
        display inline
        margin-right 8px
        background transparent url("media/img/arrow.png") no-repeat
        float right
        margin 0.3rem 0 0 0
    .open .arrow-down
        height 14px
        display inline
        background transparent url("media/img/arrowUp.png") no-repeat
        float right
        margin-top 0.3rem
    .dropdown .checkall
        display block
        margin 0 0 5px 0
        padding 0 0 5px 0
        border-bottom 1px solid #ccc
        cursor pointer
    .dropdown .selected 
        background-color rgb(113, 113, 113) !important
        color #fff
    .require_field
        color #F00
        font-size 1.8*$px
        position absolute
        top calc( 50% - 5px )
        right 13px
        background-color #FFFFFF
    .body
        background-color #FFFFFF

.bodyGetTogether
    background-color #fff

.next
    float left
    left 48%
    position relative

.nc
    &-buttons-container
        text-align center
        @media screen and (max-width 414px)
            margin-top 10px
        .nc-buttons-container-right
            width 100%
            float none
    &-button
        min-width 130px
        height 50px
        font-size 16px
        font-weight 600
        line-height 50px