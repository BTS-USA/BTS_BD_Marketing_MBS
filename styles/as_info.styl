@import "common-rules.styl"
/*------------------------------------------------------------------------------------------------------------------------------------------*/
.ic
    // &-column-left
    //     padding 0 10px 10px 0
    // &-column-right
    //     float none
    //     width 100%
    &-content
        padding 0 0 1rem 0
    &-h3
        padding 0 0 5px 0
        color $neutral-dark
        font-weight bold
    &-paragraph, &-list
        line-height 1.5rem
        table
            tr
                th
                    background-color $primary-dark
                    padding .5rem
                    color $white
                    font-weight normal
                    border 1px solid $primary-dark
                td
                    width 33.33%
                    padding 1rem
                    border 1px solid $primary-dark
                &:nth-child(odd)
                    td
                        background-color $neutral-light
                        color $black
                &:nth-child(even)
                    td
                        background-color $neutral-light

.tc-action-Activity6_AS_Moment_Scenario
    .ic-paragraph
        ul
            list-style-position inside
        li
            margin-left 0

body[class*='Activity3_AS_Ranking_Moment_Feedback']
    .tc-page__page 
        &.tc-action-Activity3_AS_Ranking_Moment_Feedback
            .ic
                &-container
                    width calc(100% - 1.5rem)
                    margin 0 .75rem 1rem
                    padding .75rem
                    box-sizing border-box
                    border 1px solid rgba(2, 26, 50, .1)
                    border-radius 10px
                    background linear-gradient(135deg, rgba(51, 122, 183, .04), rgba(255, 182, 18, .07))
                &-content
                    padding 0
                &-paragraph
                    padding .75rem .85rem
                    border-top 4px solid $secondary
                    border-radius 8px
                    background-color $white
                    box-shadow 0 3px 9px rgba(2, 26, 50, .09)
                    line-height 1.5
                    margin-bottom 0
                    p:first-child
                        margin-top 0
                    p:last-child
                        margin-bottom 0
                &-column-right
                    padding 0
                    width 100%
                    flex-basis 100%
            .pc-container 
                padding-top 0 !important

.ic
    &-article
        display block
        overflow hidden
    &-column-left
        float left
        width 43%
        box-sizing border-box
        display block
        padding 0 16px 10px 0
    &-column-right
        float none
        width 100%
        box-sizing border-box
        padding 0
        display block
    &-figure
        width 100%
        margin 0
    &-figure__image
        display block
        width 100%
        max-width 100%
        height auto
        border-radius $radius
/*------------------------------------------------------------------------------------------------------------------------------------------*/
@media screen and (max-width 1900px)
    .ic
        &-column-left
            width 50%
        &-column-right
            width 50%
            float right
// @media screen and (max-width 1500px)
//     .ic
//         &-column-left
//             width 42%
@media screen and (max-width 600px)
    .ic
        &-column-left, &-column-right
            float none
            width 100%