@import "common-rules.styl"
/*------------------------------------------------------------------------------------------------------------------------------------------*/
#votingSlideDiv
    .mainWrapper
        .ifc-instructions
            box-sizing border-box
            margin 0 0 .75rem
            padding .6rem .8rem
            border-left 4px solid $primary
            border-radius 0 $radius $radius 0
            background-color rgba($primary, .07)
            &__text
                display block
                margin 0
                padding 0
                color $neutral-dark
                font-weight 500
.ifc
    &-textarea-container
        overflow hidden
    &-footer
        float right
        margin-top .5rem
.inputComponentMessageLength
    text-align center
    position static
    width 100%
    padding .25rem
    .textAreaAD__messageLength-counter
        font-weight bold
/*------------------------------------------------------------------------------------------------------------------------------------------*/
@media screen and (max-width 600px)
    .ifc-footer
        margin-bottom 0 !important